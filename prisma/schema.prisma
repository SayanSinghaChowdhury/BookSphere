// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
    // Target runtime environment. Default: nodejs
    // runtime  = "nodejs"
}

datasource db {
    provider = "sqlite"
}

model AuthorData {
    id String @id @unique() @default(uuid())

    userName String

    book BookData[]
}

model BookData {
    id String @id @unique() @default(uuid())

    bookName String

    image String @unique

    price Int

    authorData   AuthorData? @relation(fields: [authorDataId], references: [id])
    authorDataId String?
}
